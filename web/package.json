{
  "name": "cuttldrop-web",
  "version": "0.1.0-alpha.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build ../crates/cuttl-wasm --target web --out-dir ../../web/pkg --release",
    "cert": "sh scripts/cert.sh",
    "dev": "npm run wasm && vite --configLoader runner",
    "build": "npm run wasm && tsc --noEmit && vite build --configLoader runner",
    "test": "npm run wasm && node --experimental-strip-types test/optical-display.test.ts && node test/roundtrip.mjs && node test/qr-optical.mjs",
    "preview": "vite preview --configLoader runner"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4",
    "zxing-wasm": "^3.1.2"
  }
}

{
  "name": "cuttldrop-web",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build ../crates/cuttl-wasm --target web --out-dir ../../web/pkg --release",
    "cert": "sh scripts/cert.sh",
    "dev": "npm run wasm && vite --configLoader runner",
    "build": "npm run wasm && tsc --noEmit && vite build --configLoader runner",
    "test": "npm run wasm && node test/roundtrip.mjs",
    "preview": "vite preview --configLoader runner"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^7.3.6"
  }
}
